{
  "description": "cluster",
  "type": "object",
  "properties": {
    "clusterId": {
      "type": "string",
      "description": "Cluster identifier",
      "format" : "uuid"
    },
    "datestamp": {
      "type": "string",
      "description": "date time of modification",
      "format" : "date-time"
    },
    "records": {
      "description": "List of records",
      "type": "array",
      "items": {
        "$ref": "globalRecord.json"
      }
    },
    "matchValues": {
      "description" : "Values used to match records in the cluster",
      "type" : "array",
      "items": {
        "type" : "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "clusterId", "records"
  ]
}
