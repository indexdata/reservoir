ARG GRAALVM_IMAGE=container-registry.oracle.com/graalvm/jdk:25

FROM ${GRAALVM_IMAGE} AS builder

RUN microdnf install -y maven && microdnf clean all

# Docker on GitHub Actions does not persist cache mounts so they are only useful locally
# as a GHA workaround, we fetch maven deps first and rely on Docker layer caching
# we allow overriding the mount type and source here, so e.g one can BIND mount $HOME/.m2/repository
# but this is not possible for GH runner's maven repo due to isolation
ARG MAVEN_MOUNT_TYPE=cache
ARG MAVEN_MOUNT_SOURCE=""

WORKDIR /app

COPY pom.xml .
COPY server/pom.xml server/pom.xml
COPY util/pom.xml util/pom.xml

RUN --mount=type=${MAVEN_MOUNT_TYPE},source=${MAVEN_MOUNT_SOURCE},target=/root/.m2/repository \
    mvn -B -Pdocker-build -Dlinux-native-deps dependency:go-offline

COPY server/ server
COPY util/ util
COPY descriptors/ descriptors

ARG GIT_COMMIT=master
RUN echo "git.commit.id=${GIT_COMMIT}" > server/src/main/resources/git.properties

ARG SHADE_MINIMIZE_JAR=true
RUN --mount=type=${MAVEN_MOUNT_TYPE},source=${MAVEN_MOUNT_SOURCE},target=/root/.m2/repository \
    mvn -B -DskipTests -Pdocker-build -Dlinux-native-deps -Dshade.minimizeJar="${SHADE_MINIMIZE_JAR}" package

FROM ${GRAALVM_IMAGE} AS slim

# The fat JAR relocates Log4j's property-change types to avoid java.desktop.
ENV JAVA_MODULES=\
java.base,\
java.logging,\
java.sql,\
java.xml,\
jdk.graal.compiler,\
jdk.internal.vm.ci,\
jdk.unsupported,\
org.graalvm.truffle.compiler

# Build a slim runtime image with just what's needed
RUN $JAVA_HOME/bin/jlink \
    --strip-debug \
    --no-header-files \
    --no-man-pages \
    --compress=2 \
    --add-modules $JAVA_MODULES \
    --output /opt/graalvm-slim

# store license
RUN mkdir -p /graalvm-license && \
    cp -f "$JAVA_HOME/LICENSE.txt" /graalvm-license/LICENSE.txt || true && \
    cp -f "$JAVA_HOME/NOTICE.txt" /graalvm-license/NOTICE.txt || true

FROM slim AS rootfs

# The linked JVM bundles CA certificates and timezone rules; no OS copies are needed.
RUN <<'EOF'
set -eu
export LC_ALL=C LD_LIBRARY_PATH=/opt/graalvm-slim/lib:/opt/graalvm-slim/lib/server
mkdir -p /rootfs
for file in /opt/graalvm-slim/bin/java /opt/graalvm-slim/lib/*.so /opt/graalvm-slim/lib/server/*.so; do
    ldd "$file"
done > /tmp/jvm-ldd
if grep -q 'not found' /tmp/jvm-ldd; then
    cat /tmp/jvm-ldd
    exit 1
fi
tr -s '[:blank:]' '\n' < /tmp/jvm-ldd | grep '^/' | grep -v '^/opt/graalvm-slim/' | sort -u > /tmp/runtime-libs
xargs -I % cp -L --parents % /rootfs < /tmp/runtime-libs

mkdir -p /rootfs/etc /rootfs/usr/share /rootfs/home/reservoir /rootfs/tmp
printf '%s\n' 'root:x:0:0:root:/root:/sbin/nologin' \
    'reservoir:x:1000:1000:Reservoir:/home/reservoir:/sbin/nologin' > /rootfs/etc/passwd
printf '%s\n' 'root:x:0:' 'reservoir:x:1000:' > /rootfs/etc/group
printf '%s\n' 'passwd: files' 'group: files' 'hosts: files dns' > /rootfs/etc/nsswitch.conf
chown 1000:1000 /rootfs/home/reservoir
chmod 1777 /rootfs/tmp
cp -L --parents /etc/os-release /rootfs

# Preserve licenses and versions for the copied OS components.
xargs rpm -qf --qf '%{NAME}\n' < /tmp/runtime-libs > /tmp/runtime-packages
rpm -qf --qf '%{NAME}\n' /etc/os-release >> /tmp/runtime-packages
sort -u /tmp/runtime-packages -o /tmp/runtime-packages
while read -r package; do
    rpm -q --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' "$package"
    rpm -ql "$package" | while read -r file; do
        case "$file" in
            /usr/share/licenses/*)
                if [ -f "$file" ]; then cp -L --parents "$file" /rootfs; fi ;;
        esac
    done
done < /tmp/runtime-packages > /rootfs/usr/share/reservoir-runtime-packages.txt
EOF

FROM scratch

COPY --from=rootfs /rootfs/ /
COPY --from=slim /opt/graalvm-slim /opt/graalvm-slim
COPY --from=builder --chown=1000:1000 /app/server/target/reservoir-server-fat.jar /reservoir.jar
COPY --from=slim /graalvm-license /graalvm-license

USER 1000:1000
ENV HOME=/home/reservoir
ENV TZ=UTC

ENV JAVA_TOOL_OPTIONS="\
-XX:+UseCompactObjectHeaders \
-XX:MaxRAMPercentage=70.0 \
-XX:+ExitOnOutOfMemoryError \
-XX:+UseStringDeduplication \
-Dsun.net.inetaddr.ttl=30"
ENV JAVA_HOME=/opt/graalvm-slim
ENV PATH="$JAVA_HOME/bin:${PATH}"

ENV HTTP_PORT=8081
EXPOSE $HTTP_PORT

ENTRYPOINT ["/opt/graalvm-slim/bin/java", "--sun-misc-unsafe-memory-access=allow", "--enable-native-access=ALL-UNNAMED", "-jar", "/reservoir.jar"]
